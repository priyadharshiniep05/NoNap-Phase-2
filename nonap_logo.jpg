<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 940 280" width="940" height="280" role="img" aria-label="NoNap logo" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1E293B"/><stop offset="1" stop-color="#0F172A"/>
    </linearGradient>
    <linearGradient id="ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#67E8F9"/><stop offset="1" stop-color="#22D3EE"/>
    </linearGradient>
  </defs>
  <rect width="940" height="280" fill="#0F172A"/>
  <g transform="translate(12 12) scale(0.25)">
    <rect width="1024" height="1024" rx="224" fill="url(#bg)" stroke="#22D3EE" stroke-opacity=".25" stroke-width="8"/>
    <path d="M120 512 Q512 190 904 512 Q512 834 120 512 Z" fill="#0B1220" stroke="url(#ring)" stroke-width="30" stroke-linejoin="round"/>
    <circle cx="512" cy="512" r="150" fill="#0F172A" stroke="url(#ring)" stroke-width="22"/>
    <circle cx="512" cy="512" r="88" fill="#F59E0B"/>
    <circle cx="542" cy="488" r="76" fill="#0F172A"/>
    <line x1="430" y1="430" x2="594" y2="594" stroke="#EF4444" stroke-width="24" stroke-linecap="round"/>
    <path d="M400 236 Q512 190 624 236" fill="none" stroke="#F59E0B" stroke-width="16" stroke-linecap="round"/>
    <path d="M350 186 Q512 118 674 186" fill="none" stroke="#F59E0B" stroke-width="16" stroke-linecap="round" opacity=".55"/>
  </g>
  <text x="300" y="165" font-family="Inter, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif" font-size="128" font-weight="800" letter-spacing="-3">
    <tspan fill="#F8FAFC">No</tspan><tspan fill="#22D3EE">Nap</tspan>
  </text>
  <text x="304" y="218" font-family="Inter, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif" font-size="30" font-weight="500" letter-spacing="6" fill="#94A3B8">STAY AWAKE. STAY ALIVE.</text>
</svg>

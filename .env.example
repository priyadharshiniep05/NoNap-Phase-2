# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Databases (SQLAlchemy URLs)
AUTH_DB_URL=sqlite:///server/data/auth.db
OPS_DB_URL=sqlite:///server/data/ops.db

# Security & JWT
JWT_SECRET_KEY=nonap_phase2_dev_secret_key_change_in_production_m4_mac
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Detection Pipeline
# Options: auto (uses hybrid if weights exist, else baseline) | baseline | hybrid
DETECTOR_BACKEND=auto
WEBCAM_INDEX=0
WEBCAM_FPS=10

# External Integrations
CONTROL_CENTER_WEBHOOK_URL=http://localhost:8000/mock/webhook
FCM_ENABLED=false

# Frame source: pi (Raspberry Pi posts to /api/v1/frames) | webcam (MacBook webcam)
VIDEO_SOURCE=pi
# Shared secret the Pi sends as X-Device-Key. Change it and copy it into pi_client/config.ini
DEVICE_API_KEY=nonap-dev-device-key
DEVICE_OFFLINE_SECONDS=12

# Alert levels (seconds)
L1_EYES_LOW_SECONDS=1.0
L2_EYES_LOW_SECONDS=2.0
ACK_TIMEOUT_SECONDS=10
ALERT_COOLDOWN_SECONDS=5
LAPTOP_ALARM_ENABLED=false

# Latency CSV output directory (relative to where the server is started)
LATENCY_LOG_DIR=logs

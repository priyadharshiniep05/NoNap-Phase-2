<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="1024" height="1024" role="img" aria-label="NoNap icon" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1E293B"/><stop offset="1" stop-color="#0F172A"/>
    </linearGradient>
    <linearGradient id="ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#67E8F9"/><stop offset="1" stop-color="#22D3EE"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#22D3EE" stop-opacity=".35"/><stop offset="1" stop-color="#22D3EE" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="1024" height="1024" rx="224" fill="url(#bg)"/>
  <circle cx="512" cy="512" r="420" fill="url(#glow)"/>
  <!-- open eye = driver stays awake -->
  <path d="M120 512 Q512 190 904 512 Q512 834 120 512 Z" fill="#0B1220" stroke="url(#ring)" stroke-width="30" stroke-linejoin="round"/>
  <circle cx="512" cy="512" r="150" fill="#0F172A" stroke="url(#ring)" stroke-width="22"/>
  <!-- crescent moon = sleep -->
  <circle cx="512" cy="512" r="88" fill="#F59E0B"/>
  <circle cx="542" cy="488" r="76" fill="#0F172A"/>
  <!-- "No" slash -->
  <line x1="430" y1="430" x2="594" y2="594" stroke="#EF4444" stroke-width="24" stroke-linecap="round"/>
  <!-- alert waves -->
  <path d="M400 236 Q512 190 624 236" fill="none" stroke="#F59E0B" stroke-width="16" stroke-linecap="round" opacity=".9"/>
  <path d="M350 186 Q512 118 674 186" fill="none" stroke="#F59E0B" stroke-width="16" stroke-linecap="round" opacity=".55"/>
</svg>
